# Corvanta Terraform — example variable file
#
# Copy this file to terraform.tfvars and replace the placeholder values.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored and must never be committed: it holds your
# machine-specific values (such as your current public IP for SSH access).

# AWS region for the Corvanta infrastructure.
aws_region = "eu-central-1"

# Project name used for the Corvanta infrastructure.
project_name = "Corvanta"

# Deployment environment: "production" or "staging".
environment = "production"

# EC2 instance type for the Corvanta backend.
backend_instance_type = "t3.micro"

# IPv4 host CIDR permitted to reach SSH (TCP 22) on the Corvanta backend.
# REPLACE the placeholder with your current public IPv4 address:
#   curl -4 https://checkip.amazonaws.com
# and append /32. The value must be a single host in /32 notation and must
# never be 0.0.0.0/0.
admin_cidr_block = "203.0.113.10/32"

# Absolute path to the public SSH key that Terraform registers as the AWS
# key pair "corvanta-ec2". The matching private key stays on this machine.
ssh_public_key_path = "/home/louis/.ssh/corvanta-ec2.pub"
